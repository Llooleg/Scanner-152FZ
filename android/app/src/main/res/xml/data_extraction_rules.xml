<?xml version="1.0" encoding="utf-8"?>
<!-- Исключаем все данные приложения из облачного бэкапа и переноса между устройствами.
     Резервная копия делается только вручную, в зашифрованный файл .scbak (Настройки). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
