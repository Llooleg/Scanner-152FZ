<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Safecopy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Системный splash (Android 12+ и backport через core-splashscreen).
         После него показывается Compose-экран LaunchScreen с логотипом МИРЭА. -->
    <style name="Theme.Safecopy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Safecopy</item>
    </style>
</resources>
